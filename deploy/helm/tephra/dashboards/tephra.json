{
  "uid": "tephra",
  "title": "Tephra",
  "tags": [
    "tephra",
    "security"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "cluster",
          "stream": "",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "namespace",
          "stream": "",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Alerts over time, by level",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({cluster=~\"$cluster\", stream=\"alert\", namespace=~\"$namespace\"} [$__interval]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Top rules",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (rule_id, rule_title) (count_over_time({cluster=~\"$cluster\", stream=\"alert\", namespace=~\"$namespace\"} | json rule_id=\"rule.id\", rule_title=\"rule.title\" [$__range])))",
          "legendFormat": "{{rule_id}} {{rule_title}}",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Top pods",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (namespace, pod) (count_over_time({cluster=~\"$cluster\", stream=\"alert\", namespace=~\"$namespace\"} | json pod=\"k8s.pod\" [$__range])))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Latest alerts",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 11
      },
      "description": "Newest first. Open a line for the whole event, including ancestors and the container.",
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "maxLines": 200,
          "expr": "{cluster=~\"$cluster\", stream=\"alert\", namespace=~\"$namespace\"} | json level=\"rule.level\", rule=\"rule.id\", title=\"rule.title\", pod=\"k8s.pod\", image=\"process.Image\", cmd=\"process.CommandLine\", parent=\"parent.Image\" | line_format \"[{{.level}}] {{.rule}} {{.title}} | pod {{.namespace}}/{{.pod}} | process {{.image}} | parent {{.parent}} | cmd {{.cmd}}\""
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Sensor health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Events per second, by type",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (type) (rate({cluster=~\"$cluster\", stream=\"event\"} [$__rate_interval]))",
          "legendFormat": "{{type}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ring buffer drops, by node",
      "description": "Events the kernel could not hand to the agent because the ring buffer was full, since each agent started. Flat is good.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (node) (max_over_time({cluster=~\"$cluster\", stream=\"health\", node!=\"collector\"} | json dropped=\"health.ringbuf_dropped\" | unwrap dropped [$__interval]))",
          "legendFormat": "{{node}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Export queue depth, by node",
      "description": "Records waiting in each agent for the collector.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (node) (max_over_time({cluster=~\"$cluster\", stream=\"health\", node!=\"collector\"} | json depth=\"health.export_queue_depth\" | unwrap depth [$__interval]))",
          "legendFormat": "{{node}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Records dropped at export, by node",
      "description": "Raw events discarded because an agent's export queue was full. Alerts are dropped only after every queued raw event.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (node) (max_over_time({cluster=~\"$cluster\", stream=\"health\", node!=\"collector\"} | json dropped=\"health.export_dropped_events\" | unwrap dropped [$__interval]))",
          "legendFormat": "{{node}} events",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{node}} alerts",
          "expr": "sum by (node) (max_over_time({cluster=~\"$cluster\", stream=\"health\", node!=\"collector\"} | json dropped=\"health.export_dropped_alerts\" | unwrap dropped [$__interval]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Collector push errors",
      "description": "Failed pushes to Loki since the collector started. The agents send the affected records again.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({cluster=~\"$cluster\", stream=\"health\", node=\"collector\"} | json errors=\"health.push_errors\" | unwrap errors [$__interval])",
          "legendFormat": "push errors",
          "queryType": "range"
        }
      ]
    }
  ]
}
